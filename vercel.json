{
  "version": 2,
  "routes": [
    {
      "src": "/api/verify-password",
      "dest": "/verify-password.js"
    },
    {
      "src": "/api/events",
      "dest": "/api/events.js"
    },
    {
      "src": "/(.*\\.(css|js|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2|ttf))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
